# Frozen 2026-11-01 from the nginx pilot (nginx-wrk2/pilot/pilot_report.txt).
# Doubling ladder, 8x span, topped at 40k: the highest rate the pilot drove
# cleanly (at 80k+ wrk2 used ~1.92 of its 2 cores). Changing any line means
# a new results directory — schema.json records the ladder.
LADDER="1:5000 2:10000 3:20000 4:40000"
WRK2_THREADS=2
WRK2_CONNS=100
