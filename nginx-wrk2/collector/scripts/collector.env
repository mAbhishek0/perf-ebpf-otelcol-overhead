# collector.env — constants of the nginx x collector (otelcol-contrib) pair.
# Sourced by mech.sh. Values are Platform S's config.env (collector block)
# unchanged, so a laptop scraper cell means what an S scraper cell meant.
# Each is a default (`:=`): if common/config.env ever defines the same name,
# that value wins and this file stops being the only place it lives.

: "${OTELCOL_BIN:=/opt/otelcol/otelcol-contrib}"   # install_build.sh: release tarball, not the .deb
: "${OTELCOL_VERSION_EXPECTED:=0.161.0}"           # metric names are version-specific (LESSONS); mismatch fails preflight
: "${OTELCOL_TELEMETRY_PORT:=18888}"               # fixed, non-default: a leftover collector on 8888 cannot be read instead
: "${OTELCOL_SENDING_QUEUE_SIZE:=512}"             # debug exporter sending_queue, items (S: 512)
: "${OTELCOL_BATCH_SIZE:=512}"                     # batch processor send_batch_size (S: 512)
: "${COLLECTOR_MODE:=scraper}"                     # only runnable mode; the OTLP arm is not ported
: "${COLLECTOR_SCRAPE_INTERVAL_NARROW_S:=15}"      # narrow = nginx receiver only, every 15 s
: "${COLLECTOR_SCRAPE_INTERVAL_WIDE_S:=1}"         # wide = nginx + hostmetrics (8 scrapers), every 1 s
: "${COLLECTOR_ATTACH_TIMEOUT_S:=30}"              # S: COLLECTOR_ATTACH_TIMEOUT_SECONDS
: "${COLLECTOR_DETACH_TIMEOUT_S:=15}"              # S: otel_tracer.sh SHUTDOWN_TIMEOUT_SECONDS
: "${NGINX_STATUS_PATH:=/status}"                  # stub_status, served in every run under every mechanism (workload.sh)
