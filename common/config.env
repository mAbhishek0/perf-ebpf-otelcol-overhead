# config.env — every constant the laptop benchmarks use. Sourced by every
# script; nothing is defined twice. Values marked (gate) are the shortened-run
# settings that revert to the Platform S default if their gate fails (README
# "Run plan").

PLATFORM="L"

# --- CPU layout (decided 2026-10-14). SMT off leaves the even CPUs online. ---
WORKLOAD_CPUS="0,2,4,6"        # nginx/redis/fio — the whole first L3 group
TRACER_CPUS="8,10"             # perf / BCC / otelcol userspace
GEN_CPUS="12,14"               # wrk2 / memtier, samplers
OS_CPUS="12,14"                # system.slice, user.slice, init.scope, IRQs
EXPECTED_ONLINE="0,2,4,6,8,10,12,14"
BENCH_SLICE="bench.slice"      # unrestricted slice the harness and containers run in

# --- Run structure ---
RAMP_S=30
STEADY_S=120                   # gate 1 FAILED in the 2026-11-01 pilot -> S default kept
WARMUP_REPS=1                  # (gate) S default 3
MEASURED_REPS=6                # Wilcoxon floor — never lower
MAX_TRIES=3                    # bracket attempts per cell
DRIFT_PCT=5                    # A1 vs A2: CPU limit, and the floor of the p99 limit
DRIFT_K=2                      # p99 limit = max(DRIFT_PCT, DRIFT_K x spread of the cell's B p99s)
SHUFFLE_SEED=20261014

# --- Thermal ---
COOLDOWN_DELTA_C=5             # wait until package temp <= idle + delta
COOLDOWN_MAX_S=600
TEMP_MAX_START_C=55            # preflight WAITS until the die is at or below this (pilot idle: 42 C)
TEMP_START_WAIT_S=900          # ...for at most this long, then fails
TEMP_ABORT_C=95                # safety only: refuse outright at or above (Zen 2 throttles ~95-105 C)

# --- Clock ---
CLOCK_BASE_KHZ=2900000
CLOCK_TOL_PCT=5                # amd-pstate reads ~1% high

# --- perf ---
PERF_VERSION_EXPECTED="7.0.14"
PERF_FREQ_NARROW=99
PERF_FREQ_WIDE=999
PERF_MMAP_PAGES=512
PERF_TRACE_MMAP_PAGES=512      # lossy at high rate by design; loss is recorded
PERF_DETACH_TIMEOUT_S=300
PERF_MAX_SAMPLE_RATE=100000    # pinned; the kernel lowers it on its own otherwise

# --- nginx / wrk2 ---
NGINX_IMAGE="nginx:1.24"
NGINX_IMAGE_ID="sha256:f6daac2445b0ce70e64d77442ccf62839f3f1b4c24bf6746a857eff014e798c8"
NGINX_PORT=8080
NGINX_WORKERS=4                # one per workload CPU (S used 2, leaving 2 idle)
NGINX_CONTAINER="bench-nginx"
WRK2_BIN="/usr/local/bin/wrk2"

# --- disk ---
MIN_FREE_MB=5120

# --- paths (LAPTOP_ROOT is set by the entry script) ---
STATE_DIR="${LAPTOP_ROOT}/state"
