# Small, reviewable results sync through git; bulky or machine-local data does not.
state/
**/perf.data*
**/samples/samples.tsv
logs/trace_*.txt
logs/.errors_*
*.partial
*.new

# GitHub token for sync.sh — never commit
.sync.env
# ntfy topic for progress pushes (the topic name is the secret)
notify.env
.env

# Papers (copyrighted) stay local, never in this repo
papers/
*.pdf
# ...except our own figures, generated by analysis/figures.py
!analysis/figures/*.pdf

# scratch patch files
/.p*.py
__pycache__/
