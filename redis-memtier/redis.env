# redis.env — constants of the redis workload. Sourced by redis-memtier/workload.sh.
# Defaults (`:=`): common/config.env wins if it ever defines the same name.
# MEMTIER_THREADS and MEMTIER_CLIENTS are pilot knobs and live in
# redis-memtier/pilot.env once frozen. Every value that defines a row's
# meaning is frozen into redis results' schema.json (wl_schema_json).
# Decision numbers (R2...) refer to docs/plans/2026-11-11-redis-implementation.md.

# `memtier_benchmark --version` prints one line, e.g.
#   memtier_benchmark v=2.5.2 sha=f3ff1793:0 bits=64 libevent=2.1.12-stable ...
# (logs/install_build_run1_2026-10-13.txt). Assumption: the first output line
# containing this string is the version line; a different version string
# fails preflight rather than being guessed at.
: "${MEMTIER_VERSION_EXPECTED:=v=2.5.2}"
: "${MEMTIER_RATIO:=1:10}"                 # R4: SET:GET, memtier's default, made explicit
: "${MEMTIER_KEY_PATTERN:=R:R}"            # R4: uniform random keys for SET and GET
: "${MEMTIER_DATA_SIZE:=32}"               # R3: value bytes
: "${MEMTIER_PIPELINE:=1}"                 # R4: one request in flight per connection
: "${REDIS_KEYS:=1000000}"                 # R3: ~100 MB, larger than the 16 MB L3, every GET hits
: "${REDIS_GAP_MIN_S:=2.0}"                # R7: idle gap between ramp and window, every run; perf attach took 1.2-1.4 s,
                                           # eBPF up to 2.4 s (fio timeline 42), so traced windows must not open later than untraced
# Drift check (common/bracket.sh). R11: nginx's rule, since redis is a network
# workload like nginx: p99 and no CPU floor (0 = no floor, see cpu_drift_limit).
# Recalibrate from the smoke cell's untraced runs if it fails on noise (as fio, timeline 42).
: "${DRIFT_LAT_KEY:=P99_MS}"
: "${DRIFT_CPU_FLOOR_CORES:=0}"
: "${REDIS_PYTHON:=/usr/bin/python3}"      # runs memtier_parse.py (standard library only)
# R2: no persistence (no fork, no background disk writes), loopback only.
# Port comes from config.env. The server command line is built in workload.sh
# (_redis_server_cmd) from these three, so the empty --save value needs no shell quoting.
: "${REDIS_BIND:=127.0.0.1}"
: "${REDIS_SAVE:=}"                        # empty = no RDB snapshots
: "${REDIS_APPENDONLY:=no}"
