# otelcol-contrib config, scraper mode, NARROW scope — Platform L (laptop), redis pair.
# Rendered per run by common/mech/collector.sh (_otel_render) into BUNDLE/otelcol.yaml.
# Placeholders: __SCRAPE_INTERVAL__, __NGINX_STATUS_URL__, __TELEMETRY_PORT__,
# __QUEUE_SIZE__, __BATCH_SIZE__ (values in collector.env).
# __NGINX_STATUS_URL__ is the shared renderer's one endpoint placeholder (its
# name is historical); here mech.sh fills it with redis's host:port, not a URL.
#
# Plan R14 (docs/plans/2026-11-11-redis-implementation.md). Copy of the nginx
# pair's template with ONE change: receiver `nginx` (stub_status) became
# receiver `redis` (INFO over plain TCP; redisreceiver in otelcol-contrib
# 0.161.0 defaults to no TLS, so there is no tls block). Every other
# non-comment line is byte-identical (tests/test_mech.sh checks it).
# The pipeline receiver list must stay flow style ("receivers: [a, b]"):
# common/mech/collector.sh counts receivers from that one line.
receivers:
  redis:
    endpoint: __NGINX_STATUS_URL__
    collection_interval: __SCRAPE_INTERVAL__s

processors:
  batch:
    send_batch_size: __BATCH_SIZE__

exporters:
  debug:
    verbosity: basic
    sending_queue:
      enabled: true
      queue_size: __QUEUE_SIZE__

service:
  telemetry:
    metrics:
      level: detailed
      readers:
        - pull:
            exporter:
              prometheus:
                host: 127.0.0.1
                port: __TELEMETRY_PORT__
  pipelines:
    metrics:
      receivers: [redis]
      processors: [batch]
      exporters: [debug]
